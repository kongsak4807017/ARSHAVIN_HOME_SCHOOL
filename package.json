{
  "name": "arshavin-home-school-print-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "a4:compose": "node tools/compose-explicit-a4-pages.mjs",
    "a4:preflight": "node tools/preflight-a4-layout.mjs",
    "a4:repair": "node tools/repair-explicit-a4-pages.mjs --report qa/a4-layout-report.json",
    "print:generate": "node tools/generate-worksheet-pdfs.mjs",
    "print:validate": "node tools/validate-worksheet-pdfs.mjs",
    "print:bundles": "node tools/build-subject-worksheet-bundles.mjs",
    "print:previews": "node tools/render-pdf-previews.mjs",
    "print:contact-sheets": "node tools/build-pdf-contact-sheets.mjs",
    "print:full": "npm run a4:preflight && npm run print:generate && npm run print:validate && npm run print:bundles && npm run print:previews && npm run print:contact-sheets"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.68",
    "cheerio": "1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.64.1"
  }
}
